<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_number_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:minHeight="@dimen/contact_actions_size">

    <org.fossify.commons.views.MyEditText
        android:id="@+id/contact_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="2dp"
        android:layout_toStartOf="@+id/default_toggle_icon"
        android:hint="@string/number"
        android:imeOptions="actionNext"
        android:inputType="phone"
        android:singleLine="true"
        android:textCursorDrawable="@null"
        android:textDirection="ltr"
        android:textSize="@dimen/bigger_text_size" />

    <ImageView
        android:id="@+id/default_toggle_icon"
        android:layout_width="@dimen/contact_actions_size"
        android:layout_height="@dimen/contact_actions_size"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/contact_number_type"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/contact_edit_icon_button_padding"
        app:srcCompat="@drawable/ic_default_number_unchecked" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/contact_number_type"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/contact_number_remove"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="2dp"
        android:textSize="11sp"
        tools:text="@string/mobile" />

    <ImageView
        android:id="@id/contact_number_remove"
        style="@style/ContactEditRemoveAction"
        android:contentDescription="@string/edit_remove_phone_number" />

</RelativeLayout>
